# ============ 评测集 / badcase / 报表 ============
DATASET_PATH=./data/sample_eval.json
BADCASE_PATH=./data/badcase.jsonl
REPORT_DIR=./data/reports

# ============ 可选 LLM-as-judge ============
# 不配置时走确定性打分（离线、可复现）；配置后启用 LLM 裁判
JUDGE_ENABLED=false
JUDGE_MODEL=gpt-4o-mini
JUDGE_API_BASE=
JUDGE_API_KEY=

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000
